{
    "name": "rem42/scraper-monorepo",
    "description": "Scraper monorepo for PHP packages",
    "license": "MIT",
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.1",
        "rem42/php-cs-fixer-config": "^4.1",
        "symplify/monorepo-builder": "^12.5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true
        }
    },
    "autoload": {
        "psr-4": {
            "Scraper\\ScraperColisPrive\\": "packages/scraper-colisprive/src/",
            "Scraper\\ScraperColissimo\\": "packages/scraper-colissimo/src/",
            "Scraper\\ScraperCompagnieDeboucheurs\\": "packages/scraper-compagnie-deboucheurs/src/",
            "Scraper\\ScraperDPD\\": "packages/scraper-dpd/src/",
            "Scraper\\ScraperDelivengo\\": "packages/scraper-delivengo/src/",
            "Scraper\\ScraperJeudiMerci\\": "packages/scraper-jeudimerci/src/",
            "Scraper\\ScraperLaPosteApim\\": "packages/scraper-laposte-apim/src/",
            "Scraper\\ScraperLaPostePostage\\": "packages/scraper-laposte-postage/src/",
            "Scraper\\ScraperNoGrad\\": "packages/scraper-nograd/src/",
            "Scraper\\ScraperPrestashop\\": "packages/scraper-prestashop/src/",
            "Scraper\\ScraperTnt\\": "packages/scraper-tnt/src/",
            "Scraper\\ScraperUPS\\": "packages/scraper-ups/src/",
            "Scraper\\ScraperZakeke\\": "packages/scraper-zakeke/src/",
            "Scraper\\Scraper\\": "packages/scraper/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Scraper\\ScraperColissimo\\Tests\\": "packages/scraper-colissimo/tests/",
            "Scraper\\ScraperCompagnieDeboucheurs\\Tests\\": "packages/scraper-compagnie-deboucheurs/tests/",
            "Scraper\\ScraperDelivengo\\Tests\\": "packages/scraper-delivengo/tests/",
            "Scraper\\ScraperJeudiMerci\\Tests\\": "packages/scraper-jeudimerci/tests/",
            "Scraper\\ScraperLaPosteApim\\Tests\\": "packages/scraper-laposte-apim/tests/",
            "Scraper\\ScraperLaPostePostage\\Tests\\": "packages/scraper-laposte-postage/tests/",
            "Scraper\\ScraperNoGrad\\Tests\\": "packages/scraper-nograd/tests/",
            "Scraper\\ScraperPrestashop\\Tests\\": "packages/scraper-prestashop/tests/",
            "Scraper\\ScraperTnt\\Tests\\": "packages/scraper-tnt/tests/",
            "Scraper\\ScraperUPS\\Tests\\": "packages/scraper-ups/tests/",
            "Scraper\\ScraperZakeke\\Tests\\": "packages/scraper-zakeke/tests/",
            "Scraper\\Scraper\\Tests\\": "packages/scraper/tests/"
        }
    },
    "authors": [
        {
            "name": "rem42",
            "email": "me@remy.ovh",
            "homepage": "https://remy.ovh"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-soap": "*",
        "symfony/http-client-contracts": "^3.5",
        "symfony/serializer-pack": "^1.3",
        "wsdltophp/packagebase": "~5.0"
    },
    "replace": {
        "rem42/scraper": "self.version",
        "rem42/scraper-colisprive": "self.version",
        "rem42/scraper-colissimo": "self.version",
        "rem42/scraper-compagnie-deboucheurs": "self.version",
        "rem42/scraper-delivengo": "self.version",
        "rem42/scraper-dpd": "self.version",
        "rem42/scraper-jeudimerci": "self.version",
        "rem42/scraper-laposte-apim": "self.version",
        "rem42/scraper-laposte-postage": "self.version",
        "rem42/scraper-prestashop": "self.version",
        "rem42/scraper-tnt": "self.version",
        "rem42/scraper-ups": "self.version",
        "rem42/scraper-zakeke": "self.version",
        "rem42/scraper-nograd": "self.version"
    }
}
